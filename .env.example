# Copy this file to .env and edit the values.

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_APP=app.py
FLASK_DEBUG=1

# MySQL (XAMPP defaults: user root, empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spam_detection_db
# Optional: a full SQLAlchemy URL overrides the DB_* values above
# DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/spam_detection_db?charset=utf8mb4

# Admin account created by `flask init-db` (password must be 8+ chars with a letter and a digit)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@spamguard.local
ADMIN_PASSWORD=ChangeMe123

# Set to 1 only when serving over HTTPS
SESSION_COOKIE_SECURE=0
